{
  "name": "@joboostr/notfound",
  "version": "0.5.0",
  "description": "One branded 404 page shared by every joboostr site. Ships a framework-neutral static <NotFound404> shell with a working job search (Czech and English copy, traveling design tokens, self-loaded Inter). Distributed as a git dependency (github:joboostr/joboostr-notfound#<tag>), pinned by tag.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./NotFound404.tsx",
      "default": "./NotFound404.tsx"
    },
    "./tokens.css": "./notfound-tokens.css",
    "./fonts": {
      "types": "./notFoundFonts.ts",
      "default": "./notFoundFonts.ts"
    },
    "./copy": {
      "types": "./notFound.cs.ts",
      "default": "./notFound.cs.ts"
    },
    "./copy/en": {
      "types": "./notFound.en.ts",
      "default": "./notFound.en.ts"
    }
  },
  "files": [
    "NotFound404.tsx",
    "NotFound404.module.css",
    "notfound-tokens.css",
    "notFoundFonts.ts",
    "notFound.cs.ts",
    "notFound.en.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@joboostr/tokens": "*",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "engines": {
    "node": ">=18"
  }
}
